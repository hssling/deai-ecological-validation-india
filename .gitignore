# Data — never commit raw or processed data
data_raw/
data_processed/
*.csv
*.tsv
*.xlsx
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
!results/tables/*.csv
!metadata/*.csv

# Environment
.env
*.env
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Conda / venv
.conda/
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs (keep logs/ but not large log files)
